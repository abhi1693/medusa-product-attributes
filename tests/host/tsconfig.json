{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "outDir": ".medusa/server",
    "rootDir": "."
  },
  "ts-node": { "swc": true },
  "include": ["src/**/*", "medusa-config.ts", ".medusa/types/**/*.d.ts"],
  "exclude": ["node_modules", ".medusa/server", ".medusa/admin"]
}
