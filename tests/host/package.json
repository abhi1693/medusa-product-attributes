{
  "name": "product-attributes-example",
  "version": "0.0.0",
  "private": true,
  "description": "Isolated Medusa development and compatibility host",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "medusa develop --host 0.0.0.0",
    "db:migrate": "medusa db:migrate",
    "build": "medusa build",
    "start": "medusa start",
    "bootstrap": "medusa exec ./src/scripts/bootstrap.ts",
    "seed:test": "medusa exec ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@abhi1693/medusa-rbac": "git+https://github.com/abhi1693/medusa-rbac.git#8854240f05491fa69636f84c68b6c45ec38b9488",
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/draft-order": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@tanstack/react-query": "5.107.1",
    "@zanreal/medusa-admin-kit": "0.4.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "@zanreal/medusa-admin-kit": {
      "@medusajs/framework": "$@medusajs/framework",
      "@medusajs/admin-sdk": "$@medusajs/admin-sdk",
      "@medusajs/icons": "$@medusajs/icons",
      "@medusajs/js-sdk": "$@medusajs/js-sdk",
      "@medusajs/ui": "$@medusajs/ui",
      "@medusajs/admin-shared": "2.23.0",
      "react": "$react",
      "react-dom": "$react-dom",
      "react-i18next": "18.0.1"
    }
  },
  "allowScripts": {
    "github:abhi1693/medusa-rbac#8854240f05491fa69636f84c68b6c45ec38b9488": true
  }
}
